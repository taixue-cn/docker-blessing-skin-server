{% extends 'user.base' %}

{% block title %}设置皮肤站本地备用密码{% endblock %}

{% block content %}
  <div class="card card-warning">
    <div class="card-header"><h3 class="card-title">设置皮肤站本地备用密码</h3></div>
    <form method="post" action="{{ url('/user/taixue-account/local-password') }}">
      {{ csrf_field() }}
      <div class="card-body">
        <p>太学账号验证已通过。这个密码只用于皮肤站本地备用登录，不会修改你的太学统一账号密码。</p>
        <p class="text-muted">请使用不同于太学账号的高强度密码并妥善保存。授权将在 5 分钟后失效，且只能提交一次。</p>
        {% if errors.any %}
          <div class="alert alert-danger">
            <ul class="mb-0">
              {% for error in errors.all %}<li>{{ error }}</li>{% endfor %}
            </ul>
          </div>
        {% endif %}
        <div class="form-group">
          <label for="local-password">新备用密码</label>
          <input id="local-password" class="form-control" type="password" name="password"
            required minlength="8" maxlength="32" autocomplete="new-password" autofocus>
        </div>
        <div class="form-group">
          <label for="local-password-confirmation">确认备用密码</label>
          <input id="local-password-confirmation" class="form-control" type="password"
            name="password_confirmation" required minlength="8" maxlength="32"
            autocomplete="new-password">
        </div>
      </div>
      <div class="card-footer">
        <button class="btn btn-warning" type="submit">建立本地备用密码</button>
        <a class="btn btn-default" href="{{ url('/user/taixue-account') }}">取消</a>
      </div>
    </form>
  </div>
{% endblock %}
